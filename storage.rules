rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'velmont@velmontdesign.com';
    }

    match /projects/{allPaths=**} {
      // Public pages only need optimized delivery files; admins can browse all objects.
      allow read: if isAdmin() || allPaths.matches('.*\\.(webp|avif)$');
      allow write: if isAdmin();
    }
  }
}
