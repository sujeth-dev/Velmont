rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /projects/{allPaths=**} {
      // Public pages only need optimized delivery files; admins can browse all objects.
      allow read: if request.auth != null || allPaths.matches('.*\\.(webp|avif)$');
      allow write: if request.auth != null;
    }
  }
}
